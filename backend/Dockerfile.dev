FROM node:20-alpine

# 네이티브 모듈 빌드에 필요한 도구 설치
RUN apk add --no-cache python3 make g++ git

WORKDIR /app

# pnpm 전역 설치
RUN npm install -g pnpm

# 패키지 파일만 복사
COPY package.json ./

# pnpm으로 패키지 설치
RUN pnpm install
RUN pnpm uninstall bcrypt || true
RUN pnpm install bcryptjs @types/bcryptjs class-validator class-transformer

# 나머지 소스 코드는 볼륨으로 마운트할 예정

EXPOSE 3001

# 개발 모드로 실행
CMD ["pnpm", "run", "start:dev"] 